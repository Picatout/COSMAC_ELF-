                        ; wozmon pour COSMAC elf+
                        ; Ce programme reprend les fonctionnalités 
                        ; de la première version du moniteur du Apple I 
                        ; Créé par Steve Wozniak 
                        ; Le elf+ communique avec le terminal 
                        ; à 9600 BAUD, 8 bits, 1 STOP bit 
                        ; La sortie Q du CDP1802 sert de sortie sérielle.
                        ; le flag externe ~EF2 sert d'entrée sérielle.
                        ; La routine COUT assure la sérialisation de l'octet à envoyer.
                        ; La routine CIN assure la désérialisation de l'octet reçu.
                        ; La routine PUTS permet d'envoyer une chaîne de caractère. 
                        ; dans ce qui suit:
                        ;  aaaa   représente une adresse en hexadécimal 
                        ;  bb     représente un octet en hexadécimal 
                        ;  <CR>     représente un retour à la ligne code ASCII 0xD 
                        ; fonctionnalités:
                        ;  aaaa<CR>    affiche le contenu de la mémoire à l'adresse aaaa
                        ;  aaaa.aaaa<CR> affiche le contenu de la mémoire dans l'intervalle d'adresse 
                        ;  aaaa: bb ...<CR>  modifie le contenu de la mémoire à partir de l'adresse aaaa
                        ;                avec les octets qui suivent l'adresse.
                        ;  aaaaGCR   exécute le programme à l'adresse aaaa
                        ;
                        ;  utilisation des registres 
                        ;  R1 pointeur de donnée pour tampon texte 
                        ;  R2 pointeur de pile à initialisé à 0xFFFF
                        ;  R3 PC du moniteur 
                        ;  R4 PC de la routine CIN 
                        ;  R5 PC de la routine COUT 
                        ;  R6 PC de la routine PUTS 
                        ;  RA adresse début de la plage mémoire 
                        ;  RB adresse fin de la plage mémoire
                        ;  RE.1  caractère reçu ou envoyé
                        ;  RE.0  compteur de bits pour CIN et COUT 
                        ;  RF.0  compteur délais de bit
                        ;
                        ;------------------------------------------------
                        ; Ce programme doit-être assemblé avec 
                        ; a18 
                        ; ref: https://github.com/carangil/A18
                        ;------------------------------------------------
                        ;
                        ;----------------
                        ; constantes
                        ;----------------
                        
                        			CPU 1802
                        			
                        ; caractères ASCII 
                  BS      	EQU 8H    ; back space 
                  CR      	EQU 0DH    ; carriage return 
                  ESC     	EQU 1BH    ; caractère ESCAPE 
                  SPC     	EQU 20H    ; caractère espace 
                  SHARP   	EQU 23H   ; '#' 
                  DOT     	EQU 2EH    ; '.' 
                  COL     	EQU 3AH    ; ':'
                  TICK    	EQU 60H    ; ` 
                        
                  TMP     	EQU 0       ; R0 usage temporaire 
                  STPTR     	EQU 1       ; pointeur de chaîne
                  SP      	EQU 2       ; pointeur de pile 
                  PC_MAIN 	EQU 3       ; PC routine principale 
                  PC_CIN  	EQU 4       ; PC routine CIN 
                  PC_COUT 	EQU 5       ; PC routine COUT 
                  PC_PUTS 	EQU 6       ; PC routine PUTS 
                  PC_ECHO 	EQU 7       ; PC routine ECHO 
                  PC_PRHEX 	EQU 8       ; PC routine PRHEX 
                  XAMADR  	EQU 0AH     ; pointeur adresse début intervalle  
                  ENDADR  	EQU 0BH     ; pointeur adresse fin intervalle  
                  LAST    	EQU 0CH     ; dernière valeur hexadécimale interprétée
                  MODE    	EQU 0DH     ; mode dans RD.0 
                  BCNTR   	EQU 0EH     ; compteur de bits RE.0
                  DCNTR   	EQU 0FH     ; compteur de délais RF.0
                  TPTR    	EQU 1       ; pointeur des transactions terminal 
                  STKTOP      EQU 0FFFFH  ; stack empty address, réserve  16 octets 
                  TIB     	EQU STKTOP-128-16+1  ; tampon de réception des commandes, réserve 128 octets 
                        
                  			ORG 8000H  
                        
                        ;---------------------------------------------------
                        ; suppose que le moniteur a été lancé à partir 
                        ; de elf+Mon et qu'en conséquence certaines 
                        ; initialisation sont déjà faite, tel que:
                        ;   interruptions déjà désactivé
                        ;   R2 déjà configuré comme pointeur de pile à 0xFFFF
                        ;   R3 est le PC pour ce programme.		
                        ;---------------------------------------------------
                  INIT
   8000   7b            			  SEQ
   8001   c4            			  NOP				; il faut garder Q à 1 par défaut.
   8002   f8 81         			  LDI HIGH COUT     ; HIGH PC_MAIN 
   8004   b4            			  PHI PC_CIN		; PC de CIN 
   8005   b5            			  PHI PC_COUT		; PC de COUT 
   8006   b6            			  PHI PC_PUTS		; PC de PUTS 
   8007   b7            			  PHI PC_ECHO		; PC de ECHO 
   8008   b8            			  PHI PC_PRHEX     	; PC de PRHEX 
   8009   f8 5a         			  LDI  LOW CIN      	; initialisation de  la partie basse 
   800b   a4            			  PLO  PC_CIN   	; des PC des sous-routines
   800c   f8 89         			  LDI  LOW COUT     	;
   800e   a5            			  PLO  PC_COUT  	;
   800f   f8 b5         			  LDI  LOW PUTS   	;
   8011   a6            			  PLO  PC_PUTS  	;
   8012   f8 82         			  LDI  LOW ECHO 
   8014   a7            			  PLO  PC_ECHO 
   8015   f8 31         			  LDI  LOW PRHEX 
   8017   a8            			  PLO  PC_PRHEX
   8018   f8 00         			  LDI  0 
   801a   ba            			  PHI  XAMADR       ; initialise ce pointeur 
   801b   aa            			  PLO  XAMADR       ; à l'adresse 0x0000
                        			   
                        ;--------------------------------------
                        ; routine principale 
                        ; PC=R3
                        ;--------------------------------------		
                  MAIN
   801c   f8 81         			LDI  HIGH SIGN      ; page de ce programme 
   801e   b1            			PHI  STPTR          ; initialise le pointeur de chaîne 
   801f   f8 be         			LDI  LOW SIGN       ; avec l'adresse de SIGN 
   8021   a1            			PLO  STPTR          ; et appel PUTS   
   8022   79            			MARK                ; pour imprimer le
   8023   d6            			SEP  PC_PUTS        ; message 
   8024   22            			DEC  SP             ; décrémente le pointeur de pile 
                  GETLINE                         ; réception de la commande 
   8025   f8 0d         			LDI  CR             ; passe à la ligne suivante 
   8027   d7            			SEP  PC_ECHO 
   8028   f8 23         			LDI  SHARP          ; envoie le caratère '#' au terminal 
   802a   d7            			SEP  PC_ECHO 
   802b   f8 ff         			LDI HIGH TIB        ; initialise le tampon de réception   
   802d   b1            			PHI TPTR            ; des commandes *TIB=0xFE00 
   802e   f8 70         			LDI LOW TIB    
   8030   a1            			PLO TPTR      
   8031   30 3c         			BR  NEXTCHAR 
                  BACKSPACE
   8033   81            		    GLO TPTR
   8034   fb 70         		    XRI LOW TIB  
   8036   32 3c         		    BZ  NEXTCHAR 
   8038   f8 08         		    LDI BS 
   803a   d7            		    SEP PC_ECHO 
   803b   21            		    DEC TPTR  
                  NEXTCHAR 
   803c   79            		    MARK 
   803d   d4            		    SEP PC_CIN 
   803e   22            		    DEC SP 
   803f   a0            		    PLO TMP 
   8040   fb 08         		    XRI BS 
   8042   32 33         		    BZ  BACKSPACE 
   8044   80            		    GLO TMP  
   8045   fb 1b         		    XRI ESC 
   8047   32 25         		    BZ  GETLINE 
   8049   80            		    GLO TMP 
   804a   ff 60         		    SMI TICK
   804c   80            		    GLO TMP  
   804d   3b 51         		    BNF UPPER  
   804f   fa df         			ANI 0DFH 		; met lettre en majuscule
                  UPPER
   8051   51            			STR TPTR 
   8052   d7            			SEP PC_ECHO 
   8053   41            			LDA TPTR
   8054   fb 0d         			XRI CR 
   8056   3a 3c         			BNZ NEXTCHAR  
                  INTERPRET 					; interprète la commande 
   8058   8a            			GLO XAMADR      ; copie XAMADR 
   8059   ab            			PLO ENDADR      ; dans LAST 
   805a   9a            			GHI XAMADR      ;
   805b   bb            			PHI ENDADR      ;
   805c   f8 ff         			LDI HIGH TIB    ; remet le pointeur au début du tampon    
   805e   b1            			PHI TPTR        ; des commandes *TIB=0xFE00 
   805f   f8 6f         			LDI LOW TIB-1    
   8061   a1            			PLO TPTR      
   8062   f8 00         			LDI 0
   8064   a0            			PLO TMP 
                  SETMODE 
   8065   80            			GLO TMP 
   8066   ad            			PLO MODE        ; mode d'opération 
                  BLSKP                      ; saute les espaces 
   8067   11            			INC  TPTR 
   8068   01            			LDN  TPTR
   8069   fb 20         			XRI  SPC         ; espace? 
   806b   32 67         			BZ   BLSKP       ; ignore 
                  NEXTITEM
   806d   01            			LDN TPTR        ; reprend le caractère dans TMP 
   806e   a0            			PLO TMP 
   806f   fb 0d         			XRI CR          ; fin de la commande?
   8071   32 25         			BZ  GETLINE     ; si oui retourne au début 
   8073   80            			GLO TMP   
   8074   ff 2e         			SMI  DOT         ; '.'? 
   8076   3b 67         			BNF BLSKP        ; ignore les caractères < '.'
   8078   32 65         			BZ SETMODE      ; 1=EXAMINE BLOCK  
   807a   80            			GLO TMP 
   807b   fb 3a         			XRI COL 
   807d   32 65         			BZ  SETMODE 
   807f   80            			GLO TMP  
   8080   fb 47         			XRI 'G'         ; 'G' go exétute un programme 
   8082   32 d8         			BZ  RUN 
   8084   81            			GLO TPTR 
   8085   b0            			PHI TMP         ; conserve la position de TPTR          
                                                    ; il faut que ce soit un entier en hexadécimal 
   8086   f8 00         			LDI 0           ; initialise le registre qui reçoit l'entier
   8088   ac            			PLO LAST        ; à zéro 
   8089   bc            			PHI LAST 
                  NEXTHEX
   808a   01            			LDN TPTR  
   808b   ff 30         			SMI 30H         ; soustrait '0' 
   808d   3b b7         			BNF NOTHEX      ; caractère invalide retourne au début 
   808f   a0            			PLO TMP         ; conserve cette valeur
   8090   ff 0a         			SMI 10          ; si < 10 DIGIT  
   8092   3b a2         			BNF  DIGIT 
   8094   80            			GLO TMP 
   8095   ff 11         			SMI 11H 
   8097   3b b7         			BNF NOTHEX 
   8099   80            			GLO TMP 
   809a   ff 17         			SMI 17H
   809c   33 b7         			BDF NOTHEX  
   809e   80            			GLO TMP         
   809f   ff 07         			SMI 7            ; A..F
   80a1   a0            			PLO TMP   
                  DIGIT			 
   80a2   80            		    GLO TMP 
   80a3   52            		    STR SP          ; met sur la pile 
   80a4   f8 04         		    LDI 4           ; LAST= 16 * LAST + M(SP)
   80a6   af            		    PLO DCNTR        
                  MULT16                  ;  16*LAST, décale last 4 bits vers la gauche
   80a7   8c            			GLO LAST 
   80a8   fe            			SHL 
   80a9   ac            			PLO LAST  
   80aa   9c            			GHI LAST  
   80ab   7e            			SHLC 
   80ac   bc            			PHI LAST  
   80ad   2f            			DEC DCNTR 
   80ae   8f            			GLO DCNTR 
   80af   3a a7         			BNZ MULT16  
   80b1   8c            			GLO LAST
   80b2   f4            			ADD 
   80b3   ac            			PLO LAST
   80b4   11            			INC TPTR 
   80b5   30 8a         			BR NEXTHEX 
                  NOTHEX
   80b7   90            			GHI TMP       ; position initiale de TPTR 
   80b8   52            			STR SP        ; EMPILE 
   80b9   81            			GLO TPTR 
   80ba   f5            			SD            ; M(RX)-D 
   80bb   32 25         			BZ  GETLINE  
                  GOTNUMBER
   80bd   8d            			GLO  MODE     ; MODE ?  
   80be   3a ca         			BNZ NOTREAD   ; 
   80c0   8c            			GLO LAST      ;sI MODE==0 copie LAST  
   80c1   aa            			PLO XAMADR    ;dans XAMADR 
   80c2   ab            			PLO ENDADR    ;et ENDADR 
   80c3   9c            			GHI LAST 
   80c4   ba            			PHI XAMADR 
   80c5   bb            			PHI ENDADR
   80c6   f8 00         			LDI 0  
   80c8   30 e3         			BR  NXTPRNT    
                  NOTREAD
   80ca   fb 2e         			XRI DOT   
   80cc   32 dd         			BZ  XAM_BLOCK 
                  STORE
   80ce   8c            			GLO LAST
   80cf   5b            			STR ENDADR
   80d0   52            			STR SP 
             DB BB 9B AB DB     EE_WAIT			       ; écrire dans l'EEPROM prend minimum 1msec
   80d1   0b            			LDN ENDADR 
   80d2   f3            			XOR 
   80d3   3a d1         			BNZ EE_WAIT 
   80d5   1b            			INC ENDADR 
   80d6   30 6d         			BR  NEXTITEM
                  RUN						 ; copy XAMADR dans R0
   80d8   9b            			GHI  ENDADR 
   80d9   b0            			PHI  0 
   80da   8b            			GLO  ENDADR 
   80db   a0            			PLO  0
   80dc   d0            			SEP  0        ; exécutre programme à cette adresse.
                  XAM_BLOCK                 ; examine un block mémoire 
   80dd   9c            			GHI LAST 
   80de   bb            			PHI ENDADR 
   80df   8c            			GLO LAST 
   80e0   ab            			PLO ENDADR  
   80e1   30 ef         			BR  PRDATA
                  NXTPRNT                  
   80e3   3a ef         			BNZ  PRDATA   ; si D<>0 imprime la valeur de LAST&0XFF
   80e5   f8 0d         			LDI  CR       ; si D=0 imprime la valeur de XAMADR 
   80e7   d7            			SEP PC_ECHO 
   80e8   9a            			GHI  XAMADR 
   80e9   d8            			SEP  PC_PRHEX
   80ea   8a            			GLO XAMADR 
   80eb   d8            			SEP  PC_PRHEX 
   80ec   f8 3a         			LDI COL 
   80ee   d7            			SEP PC_ECHO 
                  PRDATA
   80ef   f8 20         		    LDI SPC 
   80f1   d7            		    SEP PC_ECHO 
   80f2   0a            		    LDN XAMADR 
   80f3   d8            		    SEP PC_PRHEX 
   80f4   1a            		    INC XAMADR 
   80f5   8b            		    GLO ENDADR  
   80f6   52            		    STR SP 
   80f7   8a            		    GLO XAMADR 
   80f8   f5            		    SD   
   80f9   9b            		    GHI ENDADR  
   80fa   52            		    STR SP 
   80fb   9a            		    GHI XAMADR 
   80fc   75            		    SDB 
   80fd   3b 6d         		    BNF NEXTITEM
                  MOD16CHK                  ; nouvelle ligne à tous les 16 octets
   80ff   8a            		    GLO XAMADR 
   8100   fa 0f         		    ANI 15 
   8102   ca 80 ef      		    LBNZ PRDATA 
   8105   f8 00         		    LDI 0 
   8107   c0 80 e3      		    LBR NXTPRNT
                        		     
                        ;--------------------------------------
                        ; sous-routines 
                        ;---------------------------------------
                        			
                  			ORG 8130H 
                        			
                        ;---------------------------------------
                        ; PRHEX 
                        ; imprime un octetet en hexadécimal 
                        ; paramètre:
                        ;    D
                        ; sortie:
                        ;    TOP  digit fort 
                        ;    NEXT digit faible 
                        ;--------------------------------------- 
                  PRHEX_EXIT
   8130   d3            			SEP PC_MAIN 
                  PRHEX 
   8131   a0            			PLO TMP 
   8132   f6            			SHR         ; D/16
   8133   f6            			SHR 
   8134   f6            			SHR 
   8135   f6            			SHR 
   8136   fc 30         			ADI '0'  
   8138   52            			STR  SP 
   8139   ff 3a         			SMI  COL
   813b   3b 41         			BNF   PRH01 
   813d   f8 07         			LDI  7 
   813f   f4            			ADD
   8140   52            			STR SP  
                  PRH01
   8141   f0            			LDX 
   8142   79            			MARK 
   8143   d5            			SEP PC_COUT 
   8144   22            			DEC SP 
   8145   80            			GLO TMP 
   8146   fa 0f         			ANI 0FH 
   8148   fc 30         			ADI '0' 
   814a   52            			STR SP 
   814b   ff 3a         			SMI COL
   814d   3b 53         			BNF PRH02 
   814f   f8 07         			LDI 7 
   8151   f4            			ADD 
   8152   52            			STR SP 
                  PRH02		
   8153   f0            			LDX 
   8154   79            			MARK 
   8155   d5            			SEP  PC_COUT 
   8156   22            			DEC  SP 
   8157   30 30         			BR   PRHEX_EXIT
                        			
                        			
                        ;--------------------------------------
                        ; CIN 
                        ; reçoit un caractère du terminal 
                        ; PC=R4
                        ; paramètre:
                        ;   caractère reçu retourné dans D
                        ;--------------------------------------
                  CIN_EXIT
   8159   71                          DIS            ; retour au programme principal  
                  CIN
   815a   e2                          SEX SP         ; X = stack pointer
                  CIN01               
   815b   3d 5b                       BN2 CIN01        ; attend le START bit  
   815d   f8 09                       LDI 09         ; initialise le compteur de bits  
   815f   ae                          PLO BCNTR      ; RE.0 décompte les bits reçus
   8160   f8 00                       LDI 00         ; initialise caractère reçu.
   8162   52                          STR SP         ; TOP = caractère  
                  BLOOP                       ; bit loop 
   8163   f8 05                       LDI 5          ; NN=(52-22)/6 
   8165   af                          PLO DCNTR      ; RF compteur de délais 
                  DLY00                       ; boucle délais de bit
   8166   2f                          DEC DCNTR 
   8167   8f                          GLO DCNTR
   8168   3a 66                       BNZ DLY00   
   816a   f0                          LDX            ; D=C
   816b   f6                          SHR            ; décale C à droite 
   816c   35 72                       B2  DLY02      ; si ~EF2=1 va à DLY02, bit 7 reste à 0  
   816e   f9 80                       ORI 80H       ; met bit 7 à 1  
   8170   30 72                       BR  DLY02      ; ajustement pour délais
                  DLY02
   8172   52                          STR SP         ; sauvegarde C dans RF.1
   8173   2e                          DEC BCNTR  
   8174   8e                          GLO BCNTR      ; si non nul  
   8175   3a 63                       BNZ BLOOP      ;reçoit bit suivant
                  STOP                        ; attend stop bit 
   8177   f8 05                       LDI 05 
   8179   af                          PLO DCNTR      ; délais STOP bit  
                  SLOOP      
   817a   2f                          DEC DCNTR      ; décrémente RF 
   817b   8f                          GLO DCNTR       ; si non nul 
   817c   3a 7a                       BNZ SLOOP      ; boucle 
   817e   72            	          LDXA           ; D=caractère,  incrémente SP 
   817f   30 59         	          BR CIN_EXIT    ; 
                        
                        
                        ;-----------------------------------
                        ; ECHO 
                        ; PC=R7
                        ; paramètre: 
                        ;    D     caractère à envoyer
                        ;------------------------------------
                  ECHO_EXIT  
   8181   d3            			  SEP PC_MAIN 
                  ECHO
   8182   79            			  MARK
   8183   d5            			  SEP  PC_COUT 
   8184   22            			  DEC  SP 
   8185   30 81         			  BR   ECHO_EXIT 
                        			 
                        ;-------------------------------
                        ; COUT 
                        ; PC=R5 
                        ; transmet un caractère au 
                        ; terminal. 
                        ; paramètre:
                        ;   caractère à envoyer dans  
                        ;   D 
                        ;--------------------------------
                  COUT_EXIT		
   8187   12                          INC SP        ; incrémente stack pointer
   8188   71                          DIS           ; sortie de sous-routine  
                  COUT  					    ; 
                                                    ; Envoie d'un caractère ASCII sur Q 
                        							; RE.1 contient le caractère à envoyer.
                        							; RE.0 compteur de bits 
   8189   e2                          SEX SP        ; X= stack pointer
   818a   52                          STR SP        ; TOP = caractère à envoyer
   818b   f8 09                       LDI 9         ; bits count incluant start bit 
   818d   ae                          PLO BCNTR     ; dans RE.0
   818e   f0                          LDX           ; D=caractère
   818f   fe                          SHL           ; shift left 1 bit
   8190   52                          STR SP       
                  BIT_LOOP
   8191   f0                          LDX           ; D=caractère 
   8192   76                          SHRC          ; bit 0 dans DF, DF dans bit 7  
   8193   52                          STR SP        ; RE.1=C>>1
   8194   3b 99                       BNF NUL       ; bit à zéro 
   8196   7b                          SEQ           ; bit==1
   8197   30 9c                       BR B_DLY  
                  NUL                        ; bit==0
   8199   7a                          REQ
   819a   30 9c                       BR B_DLY      ; burn 2 more T 
                  B_DLY 
   819c   f8 05                       LDI 5         ; N=(52-22)/6 
   819e   af                          PLO DCNTR     ; 
                  BIT_DLY                    ; boucle durée de bit 
   819f   2f                          DEC DCNTR        
   81a0   8f                          GLO DCNTR
   81a1   3a 9f                       BNZ BIT_DLY 
   81a3   2e                          DEC BCNTR     ; décrément le compteur de bits 
   81a4   8e                          GLO BCNTR     ; RE.1=D
   81a5   3a 91                       BNZ BIT_LOOP  ; pas terminé l'envoie 
   81a7   8e                          GLO BCNTR     ; remplissage pour ajouter 
   81a8   8e                          GLO BCNTR     ; 4T de délais supplémentaire
   81a9   f8 05                       LDI 5         ; délais N=(52-22)/6 
   81ab   af                          PLO DCNTR     ; sont pour le timing 
   81ac   7b                          SEQ           ;  STOP bit
                  STP_DLY                    ; délais du stop BIT 
   81ad   2f            			  DEC DCNTR
   81ae   8f            			  GLO DCNTR
   81af   3a ad         			  BNZ STP_DLY  	
   81b1   30 87                       BR COUT_EXIT  ; terminé.  
                        
                        ;-------------------------------------
                        ; PUTS
                        ; PC=R6 
                        ; envoie une chaîne de 
                        ; caractères au terminal
                        ; paramètre:
                        ;    R1 adresse de la chaîne 
                        ;-------------------------------------
                  PUTS_EXIT  
   81b3   12            			  INC SP        ; incrémente stack pointer 
   81b4   71                          DIS           ; retouren à l'appellant 
                  PUTS 
   81b5   e2                          SEX SP        ; X=stack pointer 
   81b6   41            			  LDA  STPTR      ; D=M(R1), R1=R1+1
   81b7   32 b3         			  BZ PUTS_EXIT  ; si D nul exit
   81b9   79                          MARK          ; T=X,P M(R2)=X,P R2-1 
   81ba   d5                          SEP PC_COUT   ; PC=R6
   81bb   22            			  DEC SP        ; réajuste R2 
   81bc   30 b5                       BR  PUTS      ; boucle pour le prochain carractère.
                        
                  SIGN
   81be   43 4f 53 4d   			TEXT "COSMAC elf+ monitor, V1.0"
   81c2   41 43 20 65   
   81c6   6c 66 2b 20   
   81ca   6d 6f 6e 69   
   81ce   74 6f 72 2c   
   81d2   20 56 31 2e   
   81d6   30            
   81d7   0d 00         			BYTE CR,0
                        
                        		
                  			END 
8033  BACKSPACE     000e  BCNTR         819f  BIT_DLY       8191  BIT_LOOP  
8163  BLOOP         8067  BLSKP         0008  BS            819c  B_DLY     
815a  CIN           815b  CIN01         8159  CIN_EXIT      003a  COL       
8189  COUT          8187  COUT_EXIT     000d  CR            000f  DCNTR     
80a2  DIGIT         8166  DLY00         8172  DLY02         002e  DOT       
